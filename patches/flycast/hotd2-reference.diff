+// hotd2-web: dump main RAM / VRAM at chosen vblanks (HOTD2_DUMP_FRAMES=600,1800 HOTD2_DUMP_DIR=/path)
+static void hotd2DumpHook()
+{
+	static u64 frame;
+	static std::vector<u64> frames;
+	static const char *dir;
+	static bool init;
+	if (!init)
+	{
+		init = true;
+		dir = getenv("HOTD2_DUMP_DIR");
+		if (const char *f = getenv("HOTD2_DUMP_FRAMES"))
+			for (const char *c = f; *c; c = strchr(c, ',') ? strchr(c, ',') + 1 : c + strlen(c))
+				frames.push_back(strtoull(c, nullptr, 10));
+	}
+	frame++;
+	if (dir == nullptr || std::find(frames.begin(), frames.end(), frame) == frames.end())
+		return;
+	auto dump = [&](const char *name, u8 *p, size_t sz) {
+		std::string path = std::string(dir) + "/" + name + "_" + std::to_string(frame) + ".bin";
+		if (FILE *fp = fopen(path.c_str(), "wb")) { fwrite(p, 1, sz, fp); fclose(fp); }
+	};
+	dump("ram", &mem_b[0], RAM_SIZE);
+	dump("vram", &vram[0], VRAM_SIZE);
+	dump("aram", &aica::aica_ram[0], ARAM_SIZE);
+	dump("aregs", &aica::aica_reg[0], 0x8000);
+	gui_takeScreenshot();   // hotd2-web: also save what Flycast rendered
+	NOTICE_LOG(COMMON, "hotd2-web: dumped frame %llu", (unsigned long long)frame);
+}
+
 void Emulator::vblank()
 {
+	hotd2DumpHook();
 	EventManager::event(Event::VBlank);
 	runner.execTasks();
 	// Time out if a frame hasn't been rendered for 50 ms
